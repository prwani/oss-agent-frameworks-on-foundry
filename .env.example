# Copy to .env.local and replace each placeholder with your own resource value.
# Never commit .env.local.
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment>
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=<search-index>
MEMORY_STORE_NAME=<memory-store>
MEMORY_SCOPE=<memory-scope>
TOOLBOX_NAME=<toolbox>
SKILLS_TOOLBOX_NAME=<skills-toolbox>
CLAUDE_MODEL_DEPLOYMENT_NAME=<claude-deployment>
ANTHROPIC_FOUNDRY_RESOURCE=<foundry-resource-name>
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
MCP_SERVER_URL=https://<mcp-host>/mcp
MCP_AUTH_TOKEN=<mcp-bearer-token>
