FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment>
PORT=8088

# Storage backend selection
USE_FOUNDRY_STORAGE=false
USE_SQLITE_STORAGE=false

# For Cosmos DB (set both storage flags to false)
AZURE_COSMOS_ENDPOINT=<cosmos-endpoint>
AZURE_COSMOS_DATABASE_NAME=<database>
AZURE_COSMOS_CONTAINER_NAME=<container>

# For SQLite fallback (set USE_SQLITE_STORAGE=true)
SQLITE_STORAGE_PATH=./state/conversations.sqlite
