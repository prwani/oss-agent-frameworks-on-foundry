FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
PORT=8088

# Azure Monitor telemetry (format: InstrumentationKey=uuid;IngestionEndpoint=url)
# Leave empty or set to dummy to disable telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<instrumentation-key-uuid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
