FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
PORT=8088

# Storage backend selection
USE_FOUNDRY_STORAGE=false
USE_SQLITE_STORAGE=false

# For Cosmos DB (set both storage flags to false)
COSMOS_ENDPOINT=
COSMOS_DATABASE_NAME=
COSMOS_CONTAINER_NAME=

# For SQLite local fallback (set USE_SQLITE_STORAGE=true)
SQLITE_STORAGE_PATH=./state/conversations.sqlite

# Local testing only - set when platform context is unavailable
# LOCAL_TEST_USER_ID=local-validation-user
